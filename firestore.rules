// ============================================================
// firestore.rules  — deploy with: firebase deploy --only firestore:rules
// ============================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────
    // A user can only read and write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Sessions ───────────────────────────────────────────────
    // A user can only read/write sessions where userId matches their UID.
    match /sessions/{sessionId} {
      allow read:   if request.auth != null
                    && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && isValidSession(request.resource.data);

      allow update: if false;   // sessions are immutable after creation
      allow delete: if false;   // no deletion allowed from client
    }

    // ── Helper Functions ───────────────────────────────────────
    function isValidSession(data) {
      return data.keys().hasAll([
        'userId', 'topic', 'transcript', 'fluencyScore',
        'confidenceScore', 'grammarScore', 'timestamp'
      ])
      && data.fluencyScore is int
      && data.confidenceScore is int
      && data.grammarScore is int
      && data.fluencyScore >= 0 && data.fluencyScore <= 100
      && data.confidenceScore >= 0 && data.confidenceScore <= 100
      && data.grammarScore >= 0 && data.grammarScore <= 100;
    }
  }
}
